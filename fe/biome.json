{
	"files": {
		"includes": [
			"**",
			"!!**/routeTree.gen.ts",
			"!!**/schema.gen.ts",
			"!!**/dist",
			"!!**/.tanstack",
			"!!**/package-lock.json"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error"
			}
		}
	}
}
