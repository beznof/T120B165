{
  "files": {
    "includes": [
      "**",
      "!!**/routeTree.gen.ts",
      "!!**/dist",
      "!!**/.tanstack",
      "!!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
